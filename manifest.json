{
  "manifest_version": 3,
  "name": "AI Coupon Finder",
  "version": "1.0.0",
  "description": "Find available coupons on e-commerce websites using AI without switching tabs",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Find Coupons"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"]
    }
  ]
}
